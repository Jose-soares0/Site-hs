---
import BaseLayout from "@layouts/BaseLayout.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import WhatsAppButton from "@components/WhatsAppButton.astro";
import { services } from "@data/services";
import { createWhatsAppLink } from "@utils/whatsapp";
import { ArrowUpRight, Building2, Cctv, Fingerprint, House, Landmark, MapPinned, RadioTower, ShieldCheck } from "lucide-react";

const serviceIcons = {
  monitoring: RadioTower,
  camera: Cctv,
  security: ShieldCheck,
  tracking: MapPinned,
  home: House,
  business: Building2,
  condominium: Landmark,
  access: Fingerprint,
};
---

<BaseLayout
  title="Serviços da HS SEG | Segurança Eletrônica no Piauí"
  description="Conheça os serviços da HS SEG: monitoramento 24h, câmeras, alarmes, rastreamento veicular e segurança para empresas e condomínios."
>
  <Header />
  <main id="conteudo" class="bg-white pt-28">
    <section class="section-space">
      <div class="section-shell">
        <p class="eyebrow">Serviços</p>
        <h1 class="display-title mt-4 max-w-4xl text-[clamp(2rem,4.6vw,4.2rem)] leading-[1.04] text-black-hs">
          Soluções de segurança eletrônica para cada tipo de risco.
        </h1>
        <p class="lead-text mt-6 max-w-2xl">
          Compare monitoramento, câmeras, rastreamento e controle de acesso para identificar o ponto de partida da sua avaliação.
        </p>
        <WhatsAppButton class="mt-8" />
      </div>
    </section>

    <section class="pb-20">
      <div class="services-list section-shell grid sm:grid-cols-2 lg:grid-cols-4">
        {services.map((service, index) => {
          const Icon = serviceIcons[service.icon];

          return (
          <article class="service-card flex min-h-[284px] flex-col p-5">
            <div class="flex items-center justify-between gap-4">
              <span class="service-icon grid size-14 place-items-center" aria-hidden="true">
                <Icon size={27} strokeWidth={1.9} />
              </span>
              <span class="service-number">{String(index + 1).padStart(2, "0")}</span>
            </div>
            <h2 class="mt-6 font-display text-lg font-black text-black-hs">{service.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-6 text-gray-600">{service.description}</p>
            <a class="service-link mt-6 inline-flex items-center gap-2 font-display text-sm font-black" href={createWhatsAppLink(service.message)} target="_blank" rel="noopener noreferrer">
              {service.cta}<ArrowUpRight size={16} strokeWidth={2} aria-hidden="true" />
            </a>
          </article>
          );
        })}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
