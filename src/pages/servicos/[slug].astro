---
import BaseLayout from "@layouts/BaseLayout.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import WhatsAppButton from "@components/WhatsAppButton.astro";
import { services, type Service } from "@data/services";
import {
  ArrowLeft,
  Building2,
  Cctv,
  Check,
  Fingerprint,
  House,
  Landmark,
  MapPinned,
  RadioTower,
  ShieldCheck,
} from "lucide-react";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

const serviceIcons = {
  monitoring: RadioTower,
  camera: Cctv,
  security: ShieldCheck,
  tracking: MapPinned,
  home: House,
  business: Building2,
  condominium: Landmark,
  access: Fingerprint,
};

const Icon = serviceIcons[service.icon];

const process = [
  {
    title: "Avaliação do local",
    description: "A rotina, os acessos e os pontos que precisam de atenção são levantados antes da definição dos equipamentos.",
  },
  {
    title: "Projeto da solução",
    description: "A HS SEG organiza a combinação de tecnologia, instalação e forma de acompanhamento mais adequada ao cenário.",
  },
  {
    title: "Instalação e orientação",
    description: "O sistema é configurado e o cliente recebe as orientações necessárias para usar a solução no dia a dia.",
  },
];
---

<BaseLayout
  title={`${service.title} em Teresina | HS SEG`}
  description={service.seoDescription}
  whatsappMessage={service.message}
>
  <Header />
  <main id="conteudo">
    <section class="service-detail-hero relative isolate flex min-h-[72svh] items-end overflow-hidden bg-black-hs pt-24 text-white">
      <img
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
        src="/images/hero-fachada-hs-seg.jpg"
        alt="Fachada da HS SEG no Piauí"
        width="900"
        height="1600"
        fetchpriority="high"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(6,8,11,0.96)_0%,rgba(6,8,11,0.82)_52%,rgba(6,8,11,0.38)_100%)]"></div>
      <div class="section-shell w-full pb-16 pt-20 sm:pb-20 lg:pb-24">
        <a class="service-back-link inline-flex items-center gap-2 text-sm font-bold text-white/72" href="/#servicos">
          <ArrowLeft size={17} aria-hidden="true" /> Voltar para serviços
        </a>
        <div class="mt-10 grid max-w-4xl gap-8 lg:grid-cols-[72px_1fr] lg:items-start">
          <span class="grid size-[72px] place-items-center rounded-lg border border-white/24 bg-black/34" aria-hidden="true">
            <Icon size={34} strokeWidth={1.8} />
          </span>
          <div>
            <p class="eyebrow text-gray-line">Saiba mais</p>
            <h1 class="display-title mt-4 max-w-4xl text-[clamp(2.4rem,5.6vw,5rem)] leading-[1.02] text-white">
              {service.title}
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-white/76">{service.intro}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-space bg-white">
      <div class="section-shell">
        <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
          <div>
            <p class="eyebrow">Como essa solução ajuda</p>
            <h2 class="section-title mt-4">Proteção organizada para funcionar na rotina real.</h2>
          </div>
          <div>
            <p class="lead-text max-w-3xl">{service.description}</p>
            <div class="service-detail-highlights mt-10 grid sm:grid-cols-2">
              {service.highlights.map((highlight) => (
                <article class="service-detail-highlight py-7 sm:px-6">
                  <h3 class="font-display text-lg font-black text-black-hs">{highlight.title}</h3>
                  <p class="mt-3 text-sm leading-6 text-gray-600">{highlight.description}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-graphite py-16 text-white sm:py-20">
      <div class="section-shell">
        <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-end lg:gap-20">
          <div>
            <p class="eyebrow text-gray-line">Do projeto ao uso</p>
            <h2 class="section-title mt-4 text-white">Como a HS SEG trabalha.</h2>
          </div>
          <p class="max-w-2xl text-base leading-7 text-white/66">
            A solução começa pela necessidade do local. Equipamentos entram depois, com uma função definida dentro do projeto.
          </p>
        </div>

        <ol class="service-detail-process mt-12 grid lg:grid-cols-3">
          {process.map((step, index) => (
            <li class="border-t border-white/16 py-8 lg:px-7">
              <span class="font-display text-sm font-black text-gray-line">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mt-5 font-display text-xl font-black">{step.title}</h3>
              <p class="mt-3 max-w-sm text-sm leading-6 text-white/62">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section-space bg-white-shield">
      <div class="section-shell grid gap-14 lg:grid-cols-2 lg:gap-20">
        <div>
          <p class="eyebrow">O que pode fazer parte</p>
          <h2 class="section-title mt-4">Uma composição definida após a avaliação.</h2>
          <ul class="mt-8 grid gap-0 border-t border-gray-line">
            {service.included.map((item) => (
              <li class="flex items-center gap-3 border-b border-gray-line py-4 font-semibold text-black-hs">
                <Check className="shrink-0 text-gray-metal" size={19} strokeWidth={2.4} aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="eyebrow">Indicado para</p>
          <h2 class="section-title mt-4">Cenários em que essa solução faz sentido.</h2>
          <ul class="mt-8 grid sm:grid-cols-2">
            {service.audience.map((item) => (
              <li class="border-t border-gray-line py-5 font-display text-lg font-black text-black-hs sm:pr-6">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="dark-surface py-16 text-white sm:py-20">
      <div class="section-shell grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <p class="eyebrow text-gray-line">Solicite uma avaliação</p>
          <h2 class="section-title mt-4 max-w-4xl text-white">Quer entender como {service.title.toLowerCase()} se aplica ao seu cenário?</h2>
          <p class="mt-5 max-w-2xl text-base leading-7 text-white/68">
            Fale com a HS SEG, explique o que precisa proteger e receba uma orientação para iniciar seu orçamento.
          </p>
        </div>
        <WhatsAppButton label="Solicitar orçamento no WhatsApp" message={service.message} />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
