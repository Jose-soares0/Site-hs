---
import { createWhatsAppLink, defaultWhatsAppMessage } from "@utils/whatsapp";

interface Props {
  label?: string;
  message?: string;
  direct?: boolean;
  service?: string;
  variant?: "primary" | "secondary" | "dark";
  class?: string;
}

const {
  label = "Solicitar avaliação",
  message = defaultWhatsAppMessage,
  direct = false,
  service,
  variant = "primary",
  class: className = "",
} = Astro.props;

const variantClass =
  variant === "secondary" ? "secondary-button" : variant === "dark" ? "dark-button" : "primary-button";
---

<a
  class={`${variantClass} whatsapp-button ${className}`}
  href={direct ? createWhatsAppLink(message) : "#lead-form"}
  target={direct ? "_blank" : undefined}
  rel={direct ? "noopener noreferrer" : undefined}
  data-whatsapp-cta={direct ? label : undefined}
  data-lead-service={!direct ? service : undefined}
  aria-label={direct ? `${label} em nova aba` : undefined}
>
  <span>{label}</span>
</a>
