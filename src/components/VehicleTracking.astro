---
import WhatsAppButton from "./WhatsAppButton.astro";

const benefits = [
  "Localização em tempo real",
  "Histórico de rotas",
  "Alertas de movimentação",
  "Bloqueio conforme solução contratada",
  "Monitoramento 24h",
  "Mais controle sobre veículos e frotas",
];
---

<section id="rastreamento" class="section-space bg-black-hs text-white">
  <div class="section-shell grid gap-12 lg:grid-cols-[0.92fr_1fr] lg:items-center">
    <div class="tracking-content">
      <p class="eyebrow">Rastreamento veicular</p>
      <h2 class="section-title mt-4 text-white">Controle o trajeto, acompanhe alertas e reduza o risco sobre seus veículos.</h2>
      <p class="mt-5 text-lg leading-8 text-white/70">
        Para carro, moto ou frota, você acompanha a localização, consulta rotas e recebe alertas para agir com mais informação quando precisar.
      </p>
      <div class="tracking-benefits mt-8 grid sm:grid-cols-2">
        {benefits.map((benefit) => (
          <div class="tracking-benefit border-t border-white/14 px-1 py-3">
            <span class="text-sm font-bold text-white/84">{benefit}</span>
          </div>
        ))}
      </div>
      <WhatsAppButton
        class="mt-9"
        label="Quero rastrear meu veículo"
        message="Olá, vim pelo site da HS SEG. Quero rastrear meu veículo ou frota e gostaria de saber planos e instalação."
      />
    </div>

    <div class="tracking-panel relative overflow-hidden rounded-lg border border-white/12 bg-[#0b1118] shadow-panel">
      <img
        class="tracking-image"
        src="/images/rastreamento-veicular-real.webp"
        alt="Celular fixado no painel de um veículo exibindo um mapa com localizações de uma frota"
        width="1024"
        height="683"
        loading="lazy"
        decoding="async"
      />
      <div class="tracking-image__overlay" aria-hidden="true"></div>
      <div class="tracking-image__badge">
        <span class="tracking-image__status"></span>
        <span>Rastreamento em tempo real</span>
      </div>
      <div class="tracking-image__caption">
        <p>Localização ao vivo</p>
        <strong>Carro, moto e frota sob controle.</strong>
      </div>
    </div>
  </div>
</section>
