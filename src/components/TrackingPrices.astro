---
interface Props {
  class?: string;
}

const className = Astro.props.class;
---

<div class:list={["grid grid-cols-2 border-y border-white/20", className]} aria-label="Valores do rastreamento veicular">
  <div class="py-4 pr-4">
    <p class="text-xs font-bold uppercase text-white/60">Instalação</p>
    <strong class="mt-2 block font-display text-3xl font-black leading-none text-white sm:text-4xl">R$ 100</strong>
    <p class="mt-2 text-xs text-white/60">Pagamento único</p>
  </div>
  <div class="border-l border-white/20 py-4 pl-5">
    <p class="text-xs font-bold uppercase text-white/60">Mensalidade</p>
    <strong class="mt-2 block font-display text-3xl font-black leading-none text-white sm:text-4xl">R$ 50</strong>
    <p class="mt-2 text-xs text-white/60">Por mês</p>
  </div>
</div>
