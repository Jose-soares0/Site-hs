---
import { services } from "@data/services";
import { ArrowUpRight } from "lucide-react";

const serviceImages: Record<string, string> = {
  "monitoramento-24h": "/images/services/monitoramento.webp",
  "seguranca-eletronica": "/images/cerca-eletrica-instalacao-real.webp",
  "rastreamento-veicular": "/images/services/rastreamento-instalacao.webp",
  residencia: "/images/services/residencia.webp",
  "seguranca-para-empresas": "/images/services/empresas.webp",
  "seguranca-para-condominios": "/images/services/condominios.webp",
};

const visibleServices = services.filter(
  (service) => !["cameras-de-seguranca", "controle-de-acesso"].includes(service.slug),
);
---

<section id="servicos" class="services-section section-space bg-white">
  <div class="section-shell">
    <div class="grid gap-8 lg:grid-cols-[0.7fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow">Serviços principais</p>
        <h2 class="section-title mt-4">Tecnologia, instalação e acompanhamento em uma única operação.</h2>
      </div>
      <p class="lead-text">
        Equipamentos, instalação e acompanhamento conectados para manter cada ponto da proteção funcionando em conjunto.
      </p>
    </div>

    <div class="services-list mt-8 grid sm:grid-cols-2 lg:grid-cols-12">
      {visibleServices.map((service, index) => (
        <article id={service.title === "Monitoramento 24h" ? "monitoramento-24h" : undefined} class="service-card group scroll-mt-28 lg:col-span-4">
          <div class="service-card__media" aria-hidden="true">
            <img src={serviceImages[service.slug]} alt="" width="960" height="540" loading="lazy" decoding="async" />
          </div>
          <span class="service-number service-card__number">{String(index + 1).padStart(2, "0")}</span>
          <div class="service-card__body">
            <h3 class="font-display text-xl font-black leading-tight text-black-hs">{service.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-6 text-gray-600">{service.description}</p>
            <a
              class="service-link mt-6 inline-flex items-center gap-2 font-display text-sm font-black text-black-hs"
              href={`/servicos/${service.slug}/`}
            >
              Saiba mais
              <ArrowUpRight size={16} strokeWidth={2} aria-hidden="true" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
