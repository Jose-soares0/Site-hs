---
import { services } from "@data/services";
import { createWhatsAppLink } from "@utils/whatsapp";
import { ArrowUpRight, Building2, Cctv, Fingerprint, House, Landmark, MapPinned, RadioTower, ShieldCheck } from "lucide-react";

const serviceIcons = {
  monitoring: RadioTower,
  camera: Cctv,
  security: ShieldCheck,
  tracking: MapPinned,
  home: House,
  business: Building2,
  condominium: Landmark,
  access: Fingerprint,
};
---

<section id="servicos" class="section-space bg-white">
  <div class="section-shell">
    <div class="grid gap-8 lg:grid-cols-[0.7fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow">Serviços principais</p>
        <h2 class="section-title mt-4">Tecnologia, instalação e acompanhamento em uma única operação.</h2>
      </div>
      <p class="lead-text">
        Equipamentos, instalação e acompanhamento conectados para manter cada ponto da proteção funcionando em conjunto.
      </p>
    </div>

    <div class="services-list mt-12 grid sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service, index) => {
        const Icon = serviceIcons[service.icon];

        return (
        <article id={service.title === "Monitoramento 24h" ? "monitoramento-24h" : undefined} class="service-card group flex min-h-[284px] scroll-mt-28 flex-col p-5">
          <div class="mb-6 flex items-center justify-between gap-4">
            <span class="service-icon grid size-14 place-items-center" aria-hidden="true">
              <Icon size={27} strokeWidth={1.9} />
            </span>
            <span class="service-number">{String(index + 1).padStart(2, "0")}</span>
          </div>
          <h3 class="font-display text-xl font-black leading-tight text-black-hs">{service.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-6 text-gray-600">{service.description}</p>
          <a
            class="service-link mt-6 inline-flex items-center gap-2 font-display text-sm font-black text-black-hs"
            href={createWhatsAppLink(service.message)}
            target="_blank"
            rel="noopener noreferrer"
          >
            {service.cta}
            <ArrowUpRight size={16} strokeWidth={2} aria-hidden="true" />
          </a>
        </article>
        );
      })}
    </div>
  </div>
</section>
