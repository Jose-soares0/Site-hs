---
import WhatsAppButton from "./WhatsAppButton.astro";
---

<section id="topo" class="hero-command dark-surface">
  <img
    class="hero-command__scene"
    src="/images/hero-hs-seg-operacao.webp"
    alt="Agente da HS SEG em uma central de monitoramento com a marca da empresa"
    width="1920"
    height="1080"
    loading="eager"
    fetchpriority="high"
  />

  <div class="section-shell hero-command__inner">
    <div class="hero-command__copy">
      <h1 class="display-title text-white">
        <span class="hero-title-line"><span>Proteção ativa,</span></span>
        <span class="hero-title-line"><span>24 horas por dia.</span></span>
      </h1>
      <p class="hero-copy">
        Monitoramento, segurança eletrônica e rastreamento veicular com suporte local no Piauí.
      </p>

      <div class="hero-actions">
        <WhatsAppButton />
        <a class="secondary-button" href="#solucoes">Ver soluções</a>
      </div>
    </div>
  </div>
</section>
