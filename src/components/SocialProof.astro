---
import { site } from "@data/site";

const highlights = [
  "Instalações e manutenções",
  "Equipamentos em operação",
  "Bastidores do atendimento local",
];
---

<section id="casos" class="section-space bg-white-shield">
  <div class="section-shell">
    <div class="grid gap-8 lg:grid-cols-[0.76fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow">Operação real</p>
        <h2 class="section-title mt-4">Trabalho técnico que você pode conferir.</h2>
      </div>
      <p class="lead-text">
        No perfil da HS SEG você encontra registros de instalações, manutenção e rotina de atendimento no Piauí.
      </p>
    </div>

    <article class="social-proof-feature mt-12">
      <div class="social-proof-media">
        <img
          src="/images/fachada-detalhe-hs-seg.jpg"
          alt="Fachada e identificação da HS SEG no Piauí"
          width="900"
          height="1600"
          loading="lazy"
        />
        <div class="social-proof-stamp">
          <strong>8 anos</strong>
          <span>de experiência</span>
        </div>
      </div>

      <div class="social-proof-content">
        <p class="eyebrow">HS SEG no Instagram</p>
        <h3>Instalação, equipamentos e atendimento sem imagem de banco.</h3>
        <p>
          Confira o trabalho publicado pela própria equipe antes de solicitar uma avaliação para sua casa, empresa, condomínio ou veículo.
        </p>

        <div class="social-proof-list">
          {highlights.map((highlight) => (
            <span>{highlight}</span>
          ))}
        </div>

        <a class="social-proof-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">
          Ver trabalhos no Instagram
        </a>
      </div>
    </article>
  </div>
</section>
