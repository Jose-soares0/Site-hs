---
const partners = [
  {
    name: "DaHora Supermercados",
    image: "/images/partners/dahora-supermercados-real.jpg",
    alt: "Fachada real de uma unidade da DaHora Supermercados no Dirceu, em Teresina",
    position: "center 38%",
  },
  {
    name: "Giraffas",
    image: "/images/partners/giraffas.png",
    alt: "Fachada de uma unidade Giraffas",
    position: "center",
  },
  {
    name: "Potencial Engenharia",
    image: "/images/partners/potencial-engenharia-logo-atual.png",
    alt: "Logo da Potencial Engenharia",
    position: "center",
  },
  {
    name: "PS Training Center",
    image: "/images/partners/ps-training-center-facade-enhanced.png",
    alt: "Fachada real do PS Training Center em Teresina",
    position: "center",
  },
  {
    name: "Simplifit Academia",
    image: "/images/partners/simplifit-academia-2026.jpg",
    alt: "Fachada da Simplifit Academia",
    position: "left center",
  },
  {
    name: "CN Motos",
    image: "/images/partners/cn-motos-2026.webp",
    alt: "Fachada da CN Motos",
    position: "center 58%",
  },
  {
    name: "Missão Angelim",
    image: "/images/partners/igreja-angelim.jpg",
    alt: "Fachada real da Igreja Angelim em Teresina",
    position: "center",
  },
];

const partnerGroups = [partners, partners];
---

<section id="parceiros" class="partners-section section-space bg-white-shield">
  <div class="section-shell">
    <div class="grid gap-8 lg:grid-cols-[0.7fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow">Parceiros</p>
        <h2 class="section-title mt-4">Empresas e instituições atendidas pela HS SEG.</h2>
      </div>
      <p class="lead-text">
        Operações de diferentes segmentos onde a segurança eletrônica faz parte da rotina do local.
      </p>
    </div>
  </div>

  <div class="partner-showcase mt-8" role="region" aria-label="Empresas atendidas pela HS SEG">
    <div class="partner-showcase__track">
      {partnerGroups.map((group, groupIndex) => (
        <ul class="partner-showcase__group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
          {group.map((partner) => {
            const isLogo = partner.image.includes("logo");

            return (
              <li
                class:list={{ "partner-showcase__card": true, "partner-showcase__card--logo": isLogo }}
                tabindex={groupIndex === 0 ? "0" : undefined}
              >
                <img
                  class="partner-showcase__image"
                  src={partner.image}
                  alt={groupIndex === 0 ? partner.alt : ""}
                  width="860"
                  height="620"
                  loading={groupIndex === 0 ? "eager" : "lazy"}
                  decoding="async"
                  style={`object-position: ${partner.position};`}
                  class:list={{ "partner-showcase__image--logo": isLogo }}
                />
                {!isLogo && <div class="partner-showcase__shade" aria-hidden="true"></div>}
                {!isLogo && (
                  <div class="partner-showcase__content">
                    <div class="partner-showcase__meta">
                      <span>Cliente HS SEG</span>
                    </div>
                    <h3>{partner.name}</h3>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .partner-showcase__card--logo {
    background: #e8e9eb;
  }

  .partner-showcase__image--logo {
    height: 200%;
    padding: 0;
    object-fit: cover;
    object-position: center top !important;
    mix-blend-mode: multiply;
  }

  .partner-showcase__card:hover .partner-showcase__image--logo,
  .partner-showcase__card:focus-visible .partner-showcase__image--logo {
    transform: none;
  }
</style>
