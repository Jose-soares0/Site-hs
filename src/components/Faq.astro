---
import { faqs } from "@data/faqs";
import { Plus } from "lucide-react";
---

<section id="faq" class="section-space bg-white">
  <div class="section-shell grid gap-10 lg:grid-cols-[0.58fr_1fr]">
    <div class="faq-intro">
      <p class="eyebrow">Perguntas frequentes</p>
      <h2 class="section-title mt-4">Dúvidas que aparecem antes de pedir uma avaliação.</h2>
      <p class="lead-text mt-5">
        Entenda como funcionam avaliação, instalação, acompanhamento pelo celular e atendimento antes de solicitar seu orçamento.
      </p>
    </div>

    <div class="grid gap-3">
      {faqs.map((faq) => (
        <details class="faq-item group border-b border-gray-line py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-display text-lg font-black text-black-hs">
            {faq.question}
            <Plus className="faq-plus shrink-0 transition group-open:rotate-45" size={22} strokeWidth={2} aria-hidden="true" />
          </summary>
          <p class="mt-4 leading-7 text-gray-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
